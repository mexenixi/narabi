    "ai.defaultPrompt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رتّب الصفحات بترتيب طبيعي مناسب للتقديم، مع مراعاة نوع المستند والتواريخ وتسلسل الوجه والظهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordne die Seiten für die Einreichung sinnvoll an und berücksichtige Dokumentart, Datum sowie Vorder- und Rückseiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange the pages in a natural submission order, considering document type, dates, and front-and-back continuity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena las páginas de forma natural para su entrega, considerando el tipo de documento, las fechas y la continuidad entre anverso y reverso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classez les pages dans un ordre naturel pour le dépôt, en tenant compte du type de document, des dates et de la continuité recto verso."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סדרו את העמודים בסדר טבעי המתאים להגשה, תוך התחשבות בסוג המסמך, בתאריכים וברצף בין הצד הקדמי לאחורי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दस्तावेज़ के प्रकार, तारीखों और आगे-पीछे के पृष्ठों की निरंतरता को ध्यान में रखते हुए पृष्ठों को जमा करने के लिए स्वाभाविक क्रम में लगाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun halaman dalam urutan yang wajar untuk diserahkan dengan mempertimbangkan jenis dokumen, tanggal, dan kesinambungan sisi depan-belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina le pagine in modo naturale per la consegna, considerando tipo di documento, date e continuità fronte-retro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類の種類、日付、表裏の連続性を考慮し、提出資料として自然な順番に並べてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 종류, 날짜, 앞뒷면의 연속성을 고려해 제출 자료로 자연스러운 순서로 정렬해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet de pagina’s in een logische volgorde voor indiening, rekening houdend met documenttype, datums en voor- en achterzijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ułóż strony w naturalnej kolejności do złożenia, uwzględniając rodzaj dokumentu, daty oraz ciągłość przodu i tyłu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize as páginas em uma ordem natural para envio, considerando o tipo de documento, as datas e a continuidade entre frente e verso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расположи страницы в естественном порядке для подачи, учитывая тип документа, даты и связь лицевой и оборотной сторон."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียงหน้าให้อยู่ในลำดับที่เหมาะสมสำหรับส่ง โดยพิจารณาประเภทเอกสาร วันที่ และความต่อเนื่องของด้านหน้าและด้านหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfaları belge türü, tarihler ve ön-arka sürekliliğini dikkate alarak teslim için doğal bir sıraya diz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розташуй сторінки у природному порядку для подання, враховуючи тип документа, дати та зв’язок лицьового й зворотного боків."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp các trang theo thứ tự tự nhiên để nộp, có xét loại tài liệu, ngày tháng và tính liên tục giữa mặt trước và mặt sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请根据文档类型、日期和正反面的连续性，将页面按适合提交的自然顺序排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請依文件類型、日期及正反面連續性，將頁面排列成適合提交的自然順序。"
          }
        }
      }
    },
