    "ai.steps": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك الملف الذي أنشأته مع خدمة ذكاء اصطناعي، وأجب عن أي أسئلة عند الحاجة. ثم انسخ سطر النتيجة النهائي والصقه أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile das PDF mit einem KI-Dienst, beantworte die Fragen und füge anschließend die Ergebniszeile unten ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share the created file with an AI service and answer any questions if needed. Then copy the final result line and paste it below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte el PDF con un servicio de IA, responde sus preguntas y pega abajo la línea del resultado final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez le PDF avec un service d’IA, répondez aux questions, puis collez ci-dessous la ligne de résultat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתפו את הקובץ שנוצר עם שירות AI, והשיבו על שאלות לפי הצורך. לאחר מכן העתיקו את שורת התוצאה הסופית והדביקו אותה למטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बनाई गई फ़ाइल को किसी AI सेवा के साथ साझा करें और ज़रूरत पड़ने पर प्रश्नों के उत्तर दें। फिर अंतिम परिणाम वाली पंक्ति कॉपी करके नीचे चिपकाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagikan PDF ke layanan AI, jawab pertanyaannya, lalu tempel baris hasil akhir di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi il PDF con un servizio IA, rispondi alle domande e incolla sotto la riga del risultato finale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有先のAIへ作成したファイルを渡し、必要に応じて質問に回答してください。最後にAIが生成した結果の1行をコピーして、下へ貼り付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF를 AI 서비스와 공유하고 질문에 답한 뒤, 최종 결과 한 줄을 복사해 아래에 붙여 넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel de PDF met een AI-dienst, beantwoord de vragen en plak de uiteindelijke resultaatregel hieronder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij PDF usłudze AI, odpowiedz na pytania i wklej poniżej końcowy wiersz wyniku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe o PDF com um serviço de IA, responda às perguntas e cole abaixo a linha do resultado final."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передайте созданный файл сервису AI и при необходимости ответьте на вопросы. Затем скопируйте итоговую строку результата и вставьте её ниже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชร์ PDF กับบริการ AI ตอบคำถาม แล้วคัดลอกบรรทัดผลลัพธ์สุดท้ายมาวางด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturulan dosyayı bir AI hizmetiyle paylaşın ve gerekirse soruları yanıtlayın. Ardından son sonuç satırını kopyalayıp aşağıya yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передайте створений файл сервісу AI та за потреби дайте відповіді на запитання. Потім скопіюйте підсумковий рядок результату й вставте його нижче."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ PDF với dịch vụ AI, trả lời câu hỏi rồi dán dòng kết quả cuối cùng vào bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将创建的文件分享给 AI 服务，并根据需要回答问题。然后复制最终结果行并粘贴到下方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將建立的檔案分享給 AI 服務，並視需要回答問題。接著複製最終結果列並貼到下方。"
          }
        }
      }
    },
