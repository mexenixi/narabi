    "settings.systemLanguageNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تظهر بعض الميزات بلغة الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Funktionen können in der Gerätesprache erscheinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some features may appear in the device language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas funciones pueden aparecer en el idioma del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines fonctions peuvent s’afficher dans la langue de l’appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שחלק מהתכונות יוצגו בשפת המכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम भाषा के अनुसार"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa fitur mungkin tampil dalam bahasa perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune funzioni possono apparire nella lingua del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の機能は、端末の言語で表示される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 기능은 기기 언어로 표시될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige functies kunnen in de apparaattaal verschijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre funkcje mogą być wyświetlane w języku urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns recursos podem aparecer no idioma do aparelho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые функции могут отображаться на языке устройства."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟีเจอร์บางส่วนอาจแสดงเป็นภาษาของอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı özellikler aygıt dilinde görünebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі функції можуть відображатися мовою пристрою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số tính năng có thể hiển thị bằng ngôn ngữ của thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分功能可能以设备语言显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分功能可能以裝置語言顯示。"
          }
        }
      }
    },
    "support.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جميع الميزات مجانية. تساعد مشتريات الدعم الاختيارية في تمويل استمرار توفر التطبيق وصيانته وتحديثه. ولا تفتح المشتريات أي ميزات إضافية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Funktionen sind kostenlos. Freiwillige Unterstützung hilft bei Bereitstellung, Wartung und Updates und schaltet keine Zusatzfunktionen frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All features are free. Optional support purchases help fund ongoing availability, maintenance, and updates. Purchases never unlock extra features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las funciones son gratuitas. Las compras opcionales ayudan a mantener y actualizar la app, sin desbloquear funciones extra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les fonctions sont gratuites. Les achats de soutien facultatifs financent la disponibilité, la maintenance et les mises à jour, sans débloquer de fonctions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל התכונות זמינות בחינם. רכישות תמיכה אופציונליות מסייעות במימון המשך הזמינות, התחזוקה והעדכונים. הרכישות אינן פותחות תכונות נוספות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक समर्थन। सभी सुविधाएँ निःशुल्क हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua fitur gratis. Dukungan opsional membantu ketersediaan, pemeliharaan, dan pembaruan tanpa membuka fitur tambahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le funzioni sono gratuite. Gli acquisti facoltativi sostengono disponibilità, manutenzione e aggiornamenti senza sbloccare funzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「並び替えでポン」は全機能を無料で提供しています。任意の応援購入は、公開継続、保守、更新に活用されます。購入の有無で機能に違いはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기능은 무료입니다. 선택형 후원 구매는 앱 유지, 관리, 업데이트에 사용되며 추가 기능을 잠금 해제하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle functies zijn gratis. Vrijwillige steun helpt de app beschikbaar en bijgewerkt te houden en ontgrendelt geen extra functies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie funkcje są bezpłatne. Dobrowolne wsparcie pomaga utrzymać i aktualizować aplikację, bez odblokowywania funkcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os recursos são gratuitos. As compras opcionais ajudam na manutenção e nas atualizações, sem liberar recursos extras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все функции бесплатны. Необязательные покупки в поддержку помогают оплачивать дальнейшую доступность, обслуживание и обновления. Покупки не открывают дополнительных функций."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟีเจอร์ทั้งหมดใช้ฟรี การสนับสนุนโดยสมัครใจช่วยค่าเผยแพร่ การดูแล และการอัปเดต โดยไม่ปลดล็อกฟีเจอร์เพิ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm özellikler ücretsizdir. İsteğe bağlı destek, uygulamanın sürdürülmesine ve güncellenmesine katkı sağlar; ek özellik açmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі функції безкоштовні. Необов’язкові покупки на підтримку допомагають оплачувати подальшу доступність, обслуговування та оновлення. Покупки не відкривають додаткових функцій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi tính năng đều miễn phí. Khoản ủng hộ tùy chọn giúp duy trì, bảo trì và cập nhật ứng dụng, không mở khóa tính năng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有功能均免费。自愿支持购买用于持续上架、维护和更新，不会解锁额外功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有功能皆免費。自願支持購買用於持續上架、維護與更新，不會解鎖額外功能。"
          }
        }
      }
    },
