    "ai.shareSafety.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي ملف الذكاء الاصطناعي على صور الصفحات أو نص OCR. تحقّق من المعلومات الشخصية أو السرية قبل اختيار وجهة المشاركة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Datei enthält Seitenbilder oder OCR-Text. Prüfe persönliche oder vertrauliche Informationen, bevor du ein Ziel auswählst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI file contains page images or OCR text. Check personal or confidential information before choosing a sharing destination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo para IA contiene imágenes de páginas o texto OCR. Comprueba los datos personales o confidenciales antes de elegir dónde compartirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier pour IA contient des images de pages ou du texte OCR. Vérifiez les données personnelles ou confidentielles avant de choisir la destination."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ ה-AI כולל תמונות עמודים או טקסט OCR. יש לבדוק מידע אישי או סודי לפני בחירת יעד השיתוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI फ़ाइल में पेज चित्र या OCR टेक्स्ट होता है। साझा करने का स्थान चुनने से पहले व्यक्तिगत या गोपनीय जानकारी जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File AI berisi gambar halaman atau teks OCR. Periksa informasi pribadi atau rahasia sebelum memilih tujuan berbagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file per IA contiene immagini delle pagine o testo OCR. Controlla i dati personali o riservati prima di scegliere la destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI用ファイルにはページ画像またはOCRテキストが含まれます。個人情報や機密情報を確認してから、共有先を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 파일에는 페이지 이미지 또는 OCR 텍스트가 포함됩니다. 개인정보나 기밀정보를 확인한 후 공유 대상을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het AI-bestand bevat pagina-afbeeldingen of OCR-tekst. Controleer persoonlijke of vertrouwelijke informatie voordat je een bestemming kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik dla AI zawiera obrazy stron lub tekst OCR. Sprawdź dane osobowe i poufne przed wyborem miejsca udostępnienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo para IA contém imagens de páginas ou texto de OCR. Verifique dados pessoais ou confidenciais antes de escolher o destino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл для ИИ содержит изображения страниц или текст OCR. Проверьте личные или конфиденциальные данные перед выбором места отправки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ AI มีรูปภาพหน้าเอกสารหรือข้อความ OCR โปรดตรวจสอบข้อมูลส่วนบุคคลหรือข้อมูลลับก่อนเลือกปลายทางการแชร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka dosyası sayfa görüntüleri veya OCR metni içerir. Paylaşım hedefini seçmeden önce kişisel ya da gizli bilgileri kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл для ШІ містить зображення сторінок або текст OCR. Перевірте особисті чи конфіденційні дані перед вибором місця надсилання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp AI chứa hình ảnh trang hoặc văn bản OCR. Hãy kiểm tra thông tin cá nhân hoặc bí mật trước khi chọn nơi chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI文件包含页面图像或OCR文本。请检查个人信息或机密信息后再选择共享目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI檔案包含頁面影像或OCR文字。請檢查個人資訊或機密資訊後再選擇分享對象。"
          }
        }
      }
    },
