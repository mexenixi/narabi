    "error.saveFailed": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ المشروع. تحقّق من مساحة التخزين المتاحة وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Projekt konnte nicht gespeichert werden. Prüfe den verfügbaren Speicherplatz und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project could not be saved. Check available storage and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el proyecto. Comprueba el espacio disponible e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet n’a pas pu être enregistré. Vérifiez l’espace de stockage disponible et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לשמור את הפרויקט. יש לבדוק את נפח האחסון הפנוי ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोजेक्ट सहेजा नहीं जा सका। उपलब्ध स्टोरेज जाँचें और फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek tidak dapat disimpan. Periksa ruang penyimpanan yang tersedia, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il progetto. Controlla lo spazio disponibile e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトを保存できませんでした。空き容量を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트를 저장할 수 없습니다. 사용 가능한 저장 공간을 확인한 후 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het project kon niet worden opgeslagen. Controleer de beschikbare opslagruimte en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać projektu. Sprawdź dostępne miejsce i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o projeto. Verifique o espaço disponível e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить проект. Проверьте свободное место и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกโปรเจกต์ได้ โปรดตรวจสอบพื้นที่จัดเก็บที่ว่างแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje kaydedilemedi. Kullanılabilir depolama alanını kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти проєкт. Перевірте вільне місце та спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu dự án. Hãy kiểm tra dung lượng trống rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存项目。请检查可用存储空间，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存專案。請檢查可用儲存空間，然後再試一次。"
          }
        }
      }
    },
