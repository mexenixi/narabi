    },
    "support.message.large.03": {
      "comment": "Independent post-purchase message 3 for large support. Meanings intentionally differ by language.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت دفعة قوية للمستقبل. شكرًا لأنك اخترت دعم استمرار التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kräftiger Beitrag für die Zukunft der App. Herzlichen Dank."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your generosity gives this independent development real momentum. Thank you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por dar un respaldo tan grande a este proyecto independiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un immense encouragement vient d’arriver. Je vous en suis profondément reconnaissant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמיכה גדולה כזאת משמעותית מאוד עבור אפליקציה עצמאית. תודה רבה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वतंत्र रूप से बनाए जा रहे इस प्रोजेक्ट को इतना बड़ा सहारा देने के लिए धन्यवाद।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih telah memberi dorongan besar untuk proyek mandiri ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aiuto così grande significa moltissimo per questo progetto indipendente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きな信頼を受け取りました。長く丁寧に育てていきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 큰 도움은 독립 프로젝트에 매우 소중합니다. 오래도록 잘 이어 가겠습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een enorme bijdrage aan een onafhankelijk project. Oprecht bedankt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak duże wsparcie ma ogromne znaczenie dla niezależnego projektu. Dziękuję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um apoio desse tamanho faz muita diferença para um projeto independente. Gratidão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Такая большая помощь очень важна для независимого проекта. Спасибо от всего сердца."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แรงสนับสนุนครั้งใหญ่นี้มีความหมายมากต่อโครงการอิสระ ขอบคุณมาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağımsız bir projeye böylesine büyük destek verdiğiniz için çok teşekkürler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Така велика допомога має величезне значення для незалежного проєкту. Дякую."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một sự hỗ trợ lớn như vậy có ý nghĩa đặc biệt với dự án độc lập này. Cảm ơn bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对独立项目而言，这样的支持意义非凡。由衷感谢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對獨立專案而言，這樣的支持意義非凡。由衷感謝。"
          }
        }
      }
    },
    "support.message.medium.01": {
