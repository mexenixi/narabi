    "scan.detected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الزوايا الأربع، وحرّك المقابض الدائرية عند الحاجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die vier Ecken und verschiebe die runden Griffe bei Bedarf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the corners and drag the handles if needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba las cuatro esquinas y mueve los controles circulares si es necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les quatre coins et déplacez les poignées rondes si nécessaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקו את ארבע הפינות והזיזו את הידיות העגולות לפי הצורך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चारों कोनों की जाँच करें और ज़रूरत हो तो गोल हैंडल खिसकाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa keempat sudut dan geser pegangan bulat jika perlu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla i quattro angoli e sposta le maniglie rotonde se necessario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "四隅を確認し、必要なら丸を動かしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네 모서리를 확인하고 필요하면 원형 핸들을 움직이세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de vier hoeken en verplaats zo nodig de ronde grepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
