    "about.development.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم الذكاء الاصطناعي للمساعدة في التنفيذ، بينما يتولى المطوّر تحديد المتطلبات والتصميم والتحقق وقرارات النشر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI unterstützt die Implementierung. Anforderungen, Design, Prüfung und Veröffentlichungsentscheidungen liegen beim Entwickler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is used to assist implementation. Requirements, design, verification, and release decisions remain with the developer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se utiliza IA como apoyo en la implementación. Los requisitos, el diseño, la verificación y las decisiones de publicación corresponden al desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA est utilisée pour aider à l’implémentation. Les exigences, la conception, la vérification et les décisions de publication restent sous la responsabilité du développeur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נעשה שימוש ב-AI לסיוע במימוש. הדרישות, התכנון, האימות והחלטות הפרסום נשארים באחריות המפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्यान्वयन में सहायता के लिए AI का उपयोग किया जाता है। आवश्यकताएँ, डिज़ाइन, सत्यापन और प्रकाशन के निर्णय डेवलपर के पास रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI digunakan untuk membantu implementasi. Persyaratan, desain, verifikasi, dan keputusan rilis tetap ditentukan pengembang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA viene usata come supporto all’implementazione. Requisiti, progettazione, verifica e decisioni di pubblicazione spettano allo sviluppatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発にはAIによる実装支援を利用しています。要件、設計、検証、公開判断は開発者が行っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발에는 AI 구현 지원을 사용합니다. 요구 사항, 설계, 검증 및 공개 결정은 개발자가 담당합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI wordt gebruikt ter ondersteuning van de implementatie. Vereisten, ontwerp, verificatie en publicatiebeslissingen blijven bij de ontwikkelaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI wspiera implementację. Za wymagania, projekt, weryfikację i decyzje o publikacji odpowiada deweloper."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA é usada para auxiliar a implementação. Requisitos, design, verificação e decisões de publicação ficam a cargo do desenvolvedor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ используется для помощи в реализации. Требования, дизайн, проверка и решения о выпуске остаются за разработчиком."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ AI เพื่อช่วยในการพัฒนา ผู้พัฒนาเป็นผู้กำหนดความต้องการ ออกแบบ ตรวจสอบ และตัดสินใจเผยแพร่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama geliştirmede AI desteğinden yararlanılır. Gereksinimler, tasarım, doğrulama ve yayımlama kararları geliştiriciye aittir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ШІ використовується для допомоги в реалізації. Вимоги, дизайн, перевірка та рішення про випуск залишаються за розробником."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI được dùng để hỗ trợ triển khai. Yêu cầu, thiết kế, kiểm chứng và quyết định phát hành do nhà phát triển thực hiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发过程中使用 AI 辅助实现。需求、设计、验证和发布决定均由开发者负责。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發過程使用 AI 協助實作。需求、設計、驗證與發布決定均由開發者負責。"
          }
        }
      }
    },
