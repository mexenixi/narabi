    "support.message.large.01": {
      "comment": "Independent post-purchase message 1 for large support. Meanings intentionally differ by language.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا دعم كبير حقًا. سأحمله معي وأنا أواصل بناء التطبيق بعناية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist außergewöhnlich großzügig. Vielen Dank für dieses starke Vertrauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an extraordinary show of support. Thank you for helping the app keep growing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un apoyo enorme y muy especial. Gracias de corazón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est un soutien exceptionnel. Merci infiniment pour cette confiance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זוהי תמיכה יוצאת דופן. תודה על האמון הגדול בפרויקט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह असाधारण सहयोग है। आपके भरोसे के लिए हार्दिक धन्यवाद।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini dukungan yang luar biasa besar. Terima kasih atas kepercayaanmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un sostegno davvero straordinario. Grazie di cuore per la fiducia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "とても大きな応援をありがとうございます。今後の開発を支える大切な力になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정말 큰 응원입니다. 보내 주신 신뢰에 진심으로 감사드립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is uitzonderlijk gul. Heel veel dank voor je vertrouwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wyjątkowo hojne wsparcie. Serdecznie dziękuję za zaufanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um apoio realmente extraordinário. Muito obrigado pela confiança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это невероятно щедрая поддержка. Искренне благодарю за доверие."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือการสนับสนุนที่ยิ่งใหญ่มาก ขอบคุณสำหรับความไว้วางใจจากใจจริง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gerçekten olağanüstü bir destek. Güveniniz için içtenlikle teşekkür ederim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це надзвичайно щедра підтримка. Щиро дякую за довіру."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là một sự ủng hộ vô cùng hào phóng. Xin chân thành cảm ơn niềm tin của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一份十分慷慨的支持。谢谢你给予如此珍贵的信任。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是一份十分慷慨的支持。謝謝你給予如此珍貴的信任。"
          }
        }
      }
    },
    "support.message.large.02": {
      "comment": "Independent post-purchase message 2 for large support. Meanings intentionally differ by language.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساندتك الاستثنائية تعني الكثير لهذا المشروع المستقل. شكرًا بصدق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine große Unterstützung trägt die weitere Entwicklung ein gutes Stück mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A major boost just reached the project. I am deeply grateful for your support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu generosidad impulsa con fuerza el futuro de la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre grande générosité donne un véritable avenir à ce projet indépendant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנדיבות שלך נותנת לפיתוח תנופה חזקה לעתיד. תודה עמוקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी बड़ी मदद इस ऐप के भविष्य को मज़बूत गति देती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebaikanmu memberi tenaga nyata bagi masa depan aplikasi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua generosità dà un impulso importante al futuro dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのこれからへ、力強い後押しをいただきました。心より感謝します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 미래에 강한 추진력을 더해 주셨습니다. 감사합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw grote steun geeft de toekomst van deze app echte vaart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja pomoc nadaje przyszłości aplikacji naprawdę duże tempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua generosidade dá um impulso enorme ao futuro do aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш вклад придаёт будущему приложения серьёзный импульс."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
