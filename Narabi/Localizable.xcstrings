    "preview.zoomGestureHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب بإصبعين أو اضغط مرتين للتكبير، ثم اسحب للتحريك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Zoomen auf- und zuziehen oder doppeltippen, zum Verschieben ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinch or double-tap to zoom, then drag to move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca o toca dos veces para ampliar y arrastra para mover."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pincez ou touchez deux fois pour zoomer, puis faites glisser pour déplacer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צביטה או הקשה כפולה לשינוי גודל התצוגה, ולאחר מכן גרירה כדי להזיז."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़ूम करने के लिए पिंच या डबल-टैप करें, फिर खिसकाने के लिए ड्रैग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubit atau ketuk dua kali untuk memperbesar, lalu seret untuk memindahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pizzica o tocca due volte per ingrandire, quindi trascina per spostare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンチまたはダブルタップで拡大し、ドラッグで移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손가락을 오므리거나 두 번 탭하여 확대하고 드래그하여 이동할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Knijp of tik dubbel om in te zoomen en sleep om te verplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uszczypnij lub stuknij dwukrotnie, aby powiększyć, a następnie przeciągnij, aby przesunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o gesto de pinça ou toque duas vezes para ampliar e arraste para mover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведите или разведите пальцы либо дважды коснитесь для масштабирования, затем перетаскивайте для перемещения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จีบนิ้วหรือแตะสองครั้งเพื่อซูม แล้วลากเพื่อเลื่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınlaştırmak için kıstırın veya çift dokunun, taşımak için sürükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зведіть або розведіть пальці чи двічі торкніться для масштабування, потім перетягуйте для переміщення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụm hoặc chạm hai lần để thu phóng, rồi kéo để di chuyển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捏合或轻点两下来缩放，然后拖动来移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撥動或點兩下縮放，然後拖曳移動。"
          }
        }
      }
    },
