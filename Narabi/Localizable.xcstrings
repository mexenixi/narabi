    "about.data.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعالج المشاريع ونتائج OCR عادةً على الجهاز. ولا تُرسل ملفات الذكاء الاصطناعي تلقائيًا؛ بل يختار المستخدم وجهة المشاركة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekte und OCR-Ergebnisse werden grundsätzlich auf dem Gerät verarbeitet. Dateien für KI-Dienste werden nie automatisch gesendet; Sie wählen das Freigabeziel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects and OCR results are generally processed on the device. AI handoff files are never sent automatically; the user chooses where to share them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proyectos y los resultados de OCR se procesan, por regla general, en el dispositivo. Los archivos para IA nunca se envían automáticamente: tú eliges dónde compartirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets et les résultats OCR sont en principe traités sur l’appareil. Les fichiers destinés à une IA ne sont jamais envoyés automatiquement : vous choisissez leur destination."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרויקטים ותוצאות OCR מעובדים בדרך כלל במכשיר. קבצים להעברה ל-AI אינם נשלחים אוטומטית; המשתמש בוחר את יעד השיתוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोजेक्ट और OCR परिणाम सामान्यतः डिवाइस पर संसाधित होते हैं। AI के लिए फ़ाइलें अपने आप नहीं भेजी जातीं; उपयोगकर्ता साझा करने का स्थान चुनता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek dan hasil OCR pada umumnya diproses di perangkat. File untuk AI tidak pernah dikirim otomatis; pengguna memilih tujuan berbagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progetti e i risultati OCR vengono normalmente elaborati sul dispositivo. I file per l’IA non vengono mai inviati automaticamente: scegli tu dove condividerli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトやOCR結果は原則として端末内で処理します。AI用ファイルは自動送信されず、共有先は利用者が選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트와 OCR 결과는 원칙적으로 기기에서 처리됩니다. AI 전달 파일은 자동으로 전송되지 않으며 사용자가 공유 대상을 선택합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projecten en OCR-resultaten worden in principe op het apparaat verwerkt. Bestanden voor AI worden nooit automatisch verstuurd; je kiest zelf waar je ze deelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekty i wyniki OCR są zasadniczo przetwarzane na urządzeniu. Pliki dla AI nie są wysyłane automatycznie; użytkownik wybiera miejsce udostępnienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Projetos e resultados de OCR são processados, em geral, no dispositivo. Arquivos para IA nunca são enviados automaticamente; você escolhe onde compartilhá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проекты и результаты OCR обычно обрабатываются на устройстве. Файлы для ИИ не отправляются автоматически: место отправки выбирает пользователь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรเจกต์และผลลัพธ์ OCR จะประมวลผลบนอุปกรณ์เป็นหลัก ไฟล์สำหรับ AI จะไม่ถูกส่งอัตโนมัติ ผู้ใช้เป็นผู้เลือกปลายทางการแชร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeler ve OCR sonuçları genel olarak aygıtta işlenir. AI aktarım dosyaları otomatik gönderilmez; nereye paylaşılacağını kullanıcı seçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проєкти й результати OCR зазвичай обробляються на пристрої. Файли для ШІ не надсилаються автоматично: місце поширення обирає користувач."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dự án và kết quả OCR nhìn chung được xử lý trên thiết bị. Tệp chuyển cho AI không bao giờ tự động gửi; người dùng chọn nơi chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目和 OCR 结果原则上在设备上处理。AI 交接文件不会自动发送，共享目标由用户选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專案和 OCR 結果原則上在裝置上處理。AI 交接檔案不會自動傳送，共享對象由使用者選擇。"
          }
        }
      }
    },
