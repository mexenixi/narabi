    "output.color.note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الصورة الأصلية دون تغيير؛ ويُطبّق هذا الإعداد على المعاينة والتصدير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original bleibt unverändert; die Einstellung gilt für Vorschau und Export."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original stays unchanged; this applies to previews and exports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El original no cambia; se aplica a la vista previa y la exportación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’original reste intact ; ce réglage s’applique à l’aperçu et à l’exportation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקור נשאר ללא שינוי; ההגדרה חלה על התצוגה המקדימה ועל הייצוא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल फ़ाइल में बदलाव नहीं होगा; यह सेटिंग पूर्वावलोकन और निर्यात पर लागू होगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar asli tidak berubah; pengaturan berlaku pada pratinjau dan ekspor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’originale resta invariato; l’opzione vale per anteprima ed esportazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元画像は変更せず、表示と出力時に適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본은 변경되지 않으며 미리보기와 내보내기에 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het origineel blijft ongewijzigd; dit geldt voor voorbeeld en export."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oryginał pozostaje bez zmian; ustawienie dotyczy podglądu i eksportu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O original não muda; a opção vale para a prévia e a exportação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригинал не изменяется. Настройка применяется к предпросмотру и экспорту."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพต้นฉบับไม่เปลี่ยน การตั้งค่านี้ใช้กับตัวอย่างและการส่งออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özgün değişmez; ayar önizleme ve dışa aktarmaya uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригінал не змінюється. Налаштування застосовується до попереднього перегляду й експорту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh gốc không đổi; thiết lập áp dụng cho bản xem trước và khi xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原图保持不变；此设置用于预览和导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始影像不變；此設定套用於預覽與輸出。"
          }
        }
      }
    },
