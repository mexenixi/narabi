    "merge.warning.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تراكب الصفحات باستخدام الصفحة الأولى كلوحة، مع الحفاظ على نسب الأحجام الفعلية. ويتم قص المحتوى الموجود خارج اللوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seiten werden mit der ersten Seite als Arbeitsfläche und unter Beibehaltung der physischen Größenverhältnisse überlagert. Inhalte außerhalb der Arbeitsfläche werden abgeschnitten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages are overlaid using the first page as the canvas while preserving physical size ratios. Content outside the canvas is clipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas se superponen usando la primera como lienzo y conservando las proporciones de tamaño físico. El contenido fuera del lienzo se recorta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages sont superposées en utilisant la première comme canevas, tout en conservant les proportions de taille physique. Le contenu hors du canevas est rogné."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העמודים מונחים זה על גבי זה כשהעמוד הראשון משמש כמשטח העבודה, תוך שמירה על יחסי הגודל הפיזיים. תוכן שמחוץ למשטח ייחתך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले पृष्ठ को कैनवास मानकर पृष्ठों को एक-दूसरे के ऊपर रखा जाता है और उनके वास्तविक आकार का अनुपात बनाए रखा जाता है। कैनवास के बाहर की सामग्री काट दी जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman ditumpuk dengan halaman pertama sebagai kanvas sambil mempertahankan perbandingan ukuran fisik. Bagian di luar kanvas akan dipotong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pagine vengono sovrapposte usando la prima come area di lavoro e mantenendo i rapporti delle dimensioni fisiche. Il contenuto esterno viene ritagliato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先頭ページを基準に物理サイズ比を保って重ねます。キャンバス外は切り取られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 페이지를 캔버스로 사용하고 실제 크기 비율을 유지하여 페이지를 겹칩니다. 캔버스 밖의 내용은 잘립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagina’s worden over elkaar gelegd met de eerste pagina als canvas, met behoud van de fysieke verhoudingen. Inhoud buiten het canvas wordt afgesneden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strony są nakładane z pierwszą stroną jako obszarem roboczym, z zachowaniem proporcji rozmiarów fizycznych. Zawartość poza obszarem zostanie przycięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As páginas são sobrepostas usando a primeira como tela e mantendo as proporções de tamanho físico. O conteúdo fora da tela é cortado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страницы накладываются с использованием первой страницы как холста и с сохранением соотношений физических размеров. Содержимое за пределами холста будет обрезано."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าเอกสารมีอัตราส่วนภาพแตกต่างกัน โปรดตรวจสอบตัวอย่างก่อนส่งออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfalar, ilk sayfa tuval olarak kullanılarak ve fiziksel boyut oranları korunarak üst üste bindirilir. Tuval dışındaki içerik kırpılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторінки накладаються з використанням першої сторінки як полотна та зі збереженням співвідношень фізичних розмірів. Вміст за межами полотна буде обрізано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trang được chồng lên nhau, dùng trang đầu làm khung vẽ và giữ tỷ lệ kích thước vật lý. Nội dung ngoài khung sẽ bị cắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以第一页为画布，在保持实际尺寸比例的情况下叠加页面。画布外的内容会被裁剪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以第一頁作為畫布，在保留實際尺寸比例的情況下重疊頁面。畫布外的內容會被裁切。"
          }
        }
      }
    },
