    "projects.deleteFolderWarning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم أيضًا حذف جميع المشاريع داخل هذا المجلد نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Projekte in diesem Ordner werden ebenfalls dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects inside this folder will also be permanently deleted. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proyectos de esta carpeta también se eliminarán permanentemente. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets de ce dossier seront également supprimés définitivement. Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גם כל הפרויקטים שבתיקייה יימחקו לצמיתות. לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोल्डर के सभी प्रोजेक्ट भी स्थायी रूप से हट जाएँगे। इसे वापस नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua proyek di dalam folder ini juga akan dihapus permanen. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche tutti i progetti nella cartella verranno eliminati definitivamente. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ内のプロジェクトもすべて完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
