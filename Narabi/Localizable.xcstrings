    "discard.confirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد تجاهل جميع التغييرات؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Änderungen verwerfen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard all changes?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descartar todos los cambios?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorer toutes les modifications ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבטל את כל השינויים?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी बदलाव छोड़ें?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang semua perubahan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorare tutte le modifiche?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更をすべて破棄しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 변경 사항을 버릴까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle wijzigingen negeren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucić wszystkie zmiany?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar todas as alterações?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить все изменения?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ละทิ้งการเปลี่ยนแปลงทั้งหมดหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
