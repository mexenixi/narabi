    "error.storageFull": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مساحة تخزين كافية على جهازك. أخلِ بعض المساحة وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf deinem Gerät ist nicht genügend Speicherplatz frei. Gib Speicherplatz frei und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device does not have enough free storage. Free some space and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dispositivo no tiene suficiente espacio libre. Libera espacio e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre appareil ne dispose pas d’assez d’espace libre. Libérez de l’espace et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מספיק מקום פנוי במכשיר. יש לפנות מקום ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डिवाइस में पर्याप्त खाली स्टोरेज नहीं है। कुछ जगह खाली करें और फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruang penyimpanan kosong di perangkat tidak cukup. Kosongkan sebagian ruang, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio libero sul dispositivo non è sufficiente. Libera spazio e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末の空き容量が不足しています。空き容量を増やして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 사용 가능한 저장 공간이 부족합니다. 공간을 확보한 후 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je apparaat heeft onvoldoende vrije opslagruimte. Maak ruimte vrij en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na urządzeniu brakuje wolnego miejsca. Zwolnij trochę miejsca i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo não tem espaço livre suficiente. Libere espaço e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На устройстве недостаточно свободного места. Освободите место и повторите попытку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์มีพื้นที่จัดเก็บว่างไม่เพียงพอ โปรดเพิ่มพื้นที่ว่างแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıtınızda yeterli boş depolama alanı yok. Biraz yer açıp yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На пристрої недостатньо вільного місця. Звільніть місце та спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị không còn đủ dung lượng trống. Hãy giải phóng bớt dung lượng rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备没有足够的可用存储空间。请释放一些空间，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置沒有足夠的可用儲存空間。請釋放一些空間，然後再試一次。"
          }
        }
      }
    },
