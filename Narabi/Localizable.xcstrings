        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трохи нової енергії для наступного поліпшення. Дякую!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một chút năng lượng mới đã đến cho lần cải tiến tiếp theo. Cảm ơn bạn!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一份轻轻的支持，为下一次改进添了点能量。谢谢！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一份輕輕的支持，為下一次改進添了些能量。謝謝！"
          }
        }
      }
    },
    "support.message.small.02": {
      "comment": "Independent post-purchase message 2 for small support. Meanings intentionally differ by language.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه اللفتة الصغيرة منحت التطوير دفعة جميلة. ممتن لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Unterstützung ist angekommen. Der nächste Feinschliff kann kommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small boost just landed in the development queue. Much appreciated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu apoyo acaba de darle un empujoncito al próximo ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre soutien donne un joli coup de pouce à la prochaine amélioration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמיכה הקטנה שלך נתנה דחיפה יפה לשיפור הבא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका छोटा सा सहयोग विकास के दिन को बेहतर बना गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dukungan kecil ini membuat perbaikan berikutnya terasa lebih ringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gesto leggero che dà energia concreta allo sviluppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発の机に、ひと息つける差し入れが届きました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 책상에 기분 좋은 응원이 하나 놓였습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kwam zojuist wat frisse energie bij het toetsenbord aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To drobne wsparcie naprawdę pomaga podczas pracy nad aplikacją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu apoio deu um empurrãozinho muito bem-vindo ao desenvolvimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша небольшая поддержка заметно помогает работе над приложением."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แรงสนับสนุนนี้ช่วยเติมพลังให้การปรับปรุงครั้งถัดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu küçük destek geliştirme gününe güzel bir katkı yaptı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша невелика підтримка помітно допомагає роботі над застосунком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự ủng hộ nhỏ này mang lại động lực rất thật cho việc phát triển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发桌上刚刚多了一份好心情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發桌上剛剛多了一份好心情。"
          }
        }
      }
    },
    "support.message.small.03": {
      "comment": "Independent post-purchase message 3 for small support. Meanings intentionally differ by language.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت جرعة خفيفة من الحماس إلى لوحة المفاتيح. شكرًا!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kurzer Lichtblick zwischen zwei Codezeilen. Vielen Dank!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next tiny improvement now has a little extra fuel. Thank you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un detalle pequeño que se nota mucho al desarrollar. Gracias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit geste qui compte beaucoup derrière l’écran. Merci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קצת אנרגיה חדשה נחתה ליד המקלדת. תודה רבה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीबोर्ड तक एक प्यारा सा हौसला पहुँचा है। बहुत धन्यवाद।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada semangat baru di antara baris-baris kode. Terima kasih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tastiera ha appena ricevuto un po’ di buonumore. Grazie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の改善に、やさしい追い風をありがとうございます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 응원이 오늘의 개발에 따뜻한 바람이 되어 주었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een bescheiden gebaar dat tijdens het ontwikkelen veel betekent. Bedankt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawiatura właśnie dostała odrobinę nowej motywacji. Dzięki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem um pouco mais de ânimo ao lado do teclado agora. Valeu!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К клавиатуре только что прибавилось немного вдохновения. Спасибо."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีพลังดี ๆ เพิ่มขึ้นข้างคีย์บอร์ดแล้ว ขอบคุณนะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenin yanına biraz yeni motivasyon bırakıldı. Sağ olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біля клавіатури щойно з’явилося трохи натхнення. Дякую."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bàn phím vừa nhận thêm một chút cảm hứng. Xin cảm ơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小小的鼓励已经收到，下一步继续认真打磨。"
