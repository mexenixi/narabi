    "about.summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتيب الصفحات وتصديرها بسهولة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine lokale App zum Ordnen von PDF- und Bildseiten und Exportieren im gewünschten Format."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A private, on-device app for arranging PDF and image pages and exporting them in the format you need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app local para ordenar páginas PDF e imágenes y exportarlas en el formato que necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app locale pour organiser des pages PDF et des images, puis les exporter au format souhaité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישום פרטי שפועל במכשיר לסידור עמודי PDF ותמונות ולייצוא שלהם בפורמט הדרוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पृष्ठों को क्रम में लगाएँ और सरलता से निर्यात करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi lokal untuk menyusun halaman PDF dan gambar lalu mengekspornya dalam format yang dibutuhkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’app locale per organizzare pagine PDF e immagini ed esportarle nel formato desiderato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFや画像をページ単位で整理し、必要な形式へ出力するローカルアプリです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF와 이미지 페이지를 기기에서 정리하고 원하는 형식으로 내보내는 앱입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een lokale app om PDF- en afbeeldingspagina’s te ordenen en in het gewenste formaat te exporteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalna aplikacja do porządkowania stron PDF i obrazów oraz eksportowania ich w wybranym formacie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um app local para organizar páginas de PDF e imagens e exportá-las no formato desejado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение работает на устройстве и позволяет упорядочивать страницы PDF и изображения, а затем экспортировать их в нужном формате."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปที่ทำงานบนอุปกรณ์สำหรับจัดเรียงหน้า PDF และรูปภาพ แล้วส่งออกเป็นรูปแบบที่ต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF ve görüntü sayfalarını aygıtta düzenleyip istediğiniz biçimde dışa aktaran bir uygulama."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок працює на пристрої та дає змогу впорядковувати сторінки PDF і зображення, а потім експортувати їх у потрібному форматі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng xử lý trên thiết bị để sắp xếp trang PDF và hình ảnh rồi xuất theo định dạng cần dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一款在设备上整理 PDF 和图像页面并按所需格式导出的应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一款在裝置上整理 PDF 與影像頁面並依所需格式輸出的 App。"
          }
        }
      }
