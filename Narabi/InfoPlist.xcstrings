{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zack, sortiert!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort & Done!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Orden y listo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hop, c’est rangé !"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Susun, beres!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina e via!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並び替えでポン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 뚝딱!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo, gesorteerd!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyk, ułożone!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene e pronto!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียงปุ๊บ เสร็จปั๊บ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz, tamam!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xếp cái rẹt!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排好就行！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排好就行！"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رتّب وانتهى!"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לסדר וגמרנו!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम लगाओ, हो गया!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расставь и готово!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Упорядкуй і готово!"
          }
        }
      }
    },
