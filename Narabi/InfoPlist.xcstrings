    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類をスキャンし、ページ素材として追加するためにカメラを使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to scan documents and add them as pages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机用于扫描文档并将其添加为页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機用於掃描文件並將其加入為頁面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라는 문서를 스캔하여 페이지로 추가하는 데 사용됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se usa para escanear documentos y añadirlos como páginas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo est utilisé pour numériser des documents et les ajouter comme pages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird verwendet, um Dokumente zu scannen und als Seiten hinzuzufügen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera é usada para digitalizar documentos e adicioná-los como páginas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera viene usata per scansionare documenti e aggiungerli come pagine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De camera wordt gebruikt om documenten te scannen en als pagina’s toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparat służy do skanowania dokumentów i dodawania ich jako stron."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera, belgeleri tarayıp sayfa olarak eklemek için kullanılır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera digunakan untuk memindai dokumen dan menambahkannya sebagai halaman."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กล้องใช้สำหรับสแกนเอกสารและเพิ่มเป็นหน้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera được dùng để quét tài liệu và thêm chúng dưới dạng trang."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم الكاميرا لمسح المستندات ضوئيًا وإضافتها كصفحات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המצלמה משמשת לסריקת מסמכים ולהוספתם כעמודים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे का उपयोग दस्तावेज़ स्कैन करके उन्हें पृष्ठों के रूप में जोड़ने के लिए किया जाता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера используется для сканирования документов и добавления их как страниц."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера використовується для сканування документів і додавання їх як сторінок."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真への出力を選んだとき、並べたページを写真ライブラリへ保存するために使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you choose to export to Photos, the arranged pages are saved to your photo library."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择导出到“照片”时，整理后的页面会存储到照片图库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇輸出到「照片」時，整理後的頁面會儲存至照片圖庫。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진으로 내보내기를 선택하면 정리한 페이지가 사진 보관함에 저장됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando eliges exportar a Fotos, las páginas ordenadas se guardan en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous choisissez d’exporter vers Photos, les pages organisées sont enregistrées dans votre photothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du den Export in Fotos auswählst, werden die angeordneten Seiten in deiner Fotomediathek gespeichert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você escolhe exportar para Fotos, as páginas organizadas são salvas na fototeca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando scegli di esportare in Foto, le pagine ordinate vengono salvate nella libreria foto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer je exporteren naar Foto’s kiest, worden de geordende pagina’s in je fotobibliotheek bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po wybraniu eksportu do Zdjęć uporządkowane strony są zapisywane w bibliotece zdjęć."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraflar’a aktarmayı seçtiğinizde düzenlenen sayfalar fotoğraf arşivinize kaydedilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat Anda memilih ekspor ke Foto, halaman yang telah disusun disimpan ke perpustakaan foto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเลือกส่งออกไปยังแอปรูปภาพ หน้าที่จัดเรียงแล้วจะถูกบันทึกลงในคลังรูปภาพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn chọn xuất vào Ảnh, các trang đã sắp xếp được lưu vào thư viện ảnh."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند اختيار التصدير إلى الصور، تُحفظ الصفحات المرتبة في مكتبة الصور."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בעת בחירה בייצוא לתמונות, העמודים המסודרים נשמרים בספריית התמונות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप फ़ोटो में निर्यात करना चुनते हैं, तो व्यवस्थित पृष्ठ आपकी फ़ोटो लाइब्रेरी में सहेजे जाते हैं।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При экспорте в Фото упорядоченные страницы сохраняются в медиатеке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час експорту до Фото впорядковані сторінки зберігаються в медіатеці."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - Photo Library Usage Description",
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリから画像を選び、ページ素材として追加するために使用します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo library is used to select images and add them as pages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片图库用于选择图像并将其添加为页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片圖庫用於選取影像並將其加入為頁面。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 보관함은 이미지를 선택하여 페이지로 추가하는 데 사용됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fototeca se usa para seleccionar imágenes y añadirlas como páginas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photothèque est utilisée pour sélectionner des images et les ajouter comme pages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fotomediathek wird verwendet, um Bilder auszuwählen und als Seiten hinzuzufügen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fototeca é usada para selecionar imagens e adicioná-las como páginas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La libreria foto viene usata per scegliere immagini e aggiungerle come pagine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De fotobibliotheek wordt gebruikt om afbeeldingen te kiezen en als pagina’s toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteka zdjęć służy do wybierania obrazów i dodawania ich jako stron."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf arşivi, görüntü seçip sayfa olarak eklemek için kullanılır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perpustakaan foto digunakan untuk memilih gambar dan menambahkannya sebagai halaman."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลังรูปภาพใช้สำหรับเลือกรูปภาพและเพิ่มเป็นหน้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện ảnh được dùng để chọn hình ảnh và thêm chúng dưới dạng trang."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم مكتبة الصور لاختيار الصور وإضافتها كصفحات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספריית התמונות משמשת לבחירת תמונות ולהוספתן כעמודים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो लाइब्रेरी का उपयोग चित्र चुनकर उन्हें पृष्ठों के रूप में जोड़ने के लिए किया जाता है।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медиатека используется для выбора изображений и добавления их как страниц."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Медіатека використовується для вибору зображень і додавання їх як сторінок."
          }
        }
      }
    }
  },
  "version": "1.2"
}
